# Copy to .env (git-ignored) or export in your shell. The backend reads these
# names (backend/src/cashflow_app/config.py). Never put secrets in this file:
# AWS credentials come from the standard credential chain (profile/SSO/env).

# mock = rule-based planner, no model call (default). live = Amazon Bedrock.
APP_MODE=mock

# Required only when APP_MODE=live. Use a model/inference-profile ID that your
# account can invoke in that region; nothing is assumed here.
AWS_REGION=
BEDROCK_MODEL_ID=
# Optional: named local profile for the credential chain.
AWS_PROFILE=

# memory | local (JSON file under DATA_DIR, atomic writes). Default: local.
STORAGE_BACKEND=local
# DATA_DIR=data/local
# FIXTURE_DIR=data/synthetic/demo-v1

# Trusted business context; the model can never choose this.
BUSINESS_ID=demo-business

# Behaviour limits.
DEFAULT_HORIZON_DAYS=30
MAX_TOOL_CALLS=6
MODEL_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=800
# Set to false for any shared deployment.
DEMO_RESET_ENABLED=true

# Bind address for uvicorn when started via `python -m cashflow_app.main`.
BIND_HOST=127.0.0.1
BIND_PORT=8000
